{
  "name": "vp-shield-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently -k \"vite\" \"cross-env ELECTRON_DEV=true electron electron/main.cjs\"",
    "electron:build": "vite build && electron-builder",
    "electron:preview": "vite build && electron electron/main.cjs",
    "download-jre": "node scripts/download-jre.cjs",
    "start": "npm run electron:dev"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "pinia": "^2.2.0",
    "vue": "^3.5.32"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.2.2",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.0",
    "sharp": "^0.34.5",
    "tailwindcss": "^3.4.0",
    "vite": "^8.0.8",
    "vite-plugin-vue-devtools": "^8.1.1"
  },
  "main": "electron/main.cjs",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
